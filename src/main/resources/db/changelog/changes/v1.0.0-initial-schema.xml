<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1.0.0-create-initial-schema" author="announcement-tracker">

        <!-- Table: admin_users -->
        <createTable tableName="admin_users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_admin_users_username"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="full_name" type="VARCHAR(255)"/>
            <column name="last_login_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Table: subscribers -->
        <createTable tableName="subscribers">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_subscribers_email"/>
            </column>
            <column name="full_name" type="VARCHAR(255)"/>
            <column name="password_hash" type="VARCHAR(255)"/>
            <column name="activation_token" type="VARCHAR(255)"/>
            <column name="token_expiry" type="TIMESTAMP"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Table: subscriber_site_preferences -->
        <createTable tableName="subscriber_site_preferences">
            <column name="subscriber_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="site_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="subscriber_site_preferences" 
                       columnNames="subscriber_id, site_type" 
                       constraintName="pk_subscriber_site_preferences"/>

        <addForeignKeyConstraint baseTableName="subscriber_site_preferences"
                                 baseColumnNames="subscriber_id"
                                 constraintName="fk_subscriber_site_preferences_subscriber"
                                 referencedTableName="subscribers"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <!-- Table: system_settings -->
        <createTable tableName="system_settings">
            <column name="setting_key" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="setting_value" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <!-- Table: announcements -->
        <createTable tableName="announcements">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="TEXT"/>
            <column name="announcement_date" type="DATE"/>
            <column name="source_site" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="source_url" type="VARCHAR(1000)"/>
            <column name="attachment_url" type="VARCHAR(1000)"/>
            <column name="image_url" type="VARCHAR(1000)"/>
            <column name="content_hash" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_announcements_content_hash"/>
            </column>
            <column name="is_notified" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="notified_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Indexes for announcements -->
        <createIndex indexName="idx_announcement_hash" tableName="announcements" unique="true">
            <column name="content_hash"/>
        </createIndex>

        <createIndex indexName="idx_announcement_site" tableName="announcements">
            <column name="source_site"/>
        </createIndex>

        <createIndex indexName="idx_announcement_notified" tableName="announcements">
            <column name="is_notified"/>
        </createIndex>

        <createIndex indexName="idx_announcement_date" tableName="announcements">
            <column name="announcement_date"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
