<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1.1.0-add-subscriber-auth-fields" author="announcement-tracker">
        <preConditions onFail="MARK_RAN">
            <not>
                <and>
                    <columnExists tableName="subscribers" columnName="password_hash"/>
                    <columnExists tableName="subscribers" columnName="activation_token"/>
                    <columnExists tableName="subscribers" columnName="token_expiry"/>
                </and>
            </not>
        </preConditions>
        <addColumn tableName="subscribers">
            <column name="password_hash" type="VARCHAR(255)"/>
            <column name="activation_token" type="VARCHAR(255)"/>
            <column name="token_expiry" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
