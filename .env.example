# Database
DB_URL=jdbc:postgresql://localhost:5432/announcement_tracker_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Mail
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=change-me
SPRING_MAIL_PASSWORD=change-me
MAIL_FROM=noreply@example.com

# Keycloak
KEYCLOAK_SERVER_URL=https://identity.example.com
KEYCLOAK_ISSUER_URI=https://identity.example.com/realms/announcement-tracker-realm
KEYCLOAK_JWK_SET_URI=https://identity.example.com/realms/announcement-tracker-realm/protocol/openid-connect/certs
KEYCLOAK_REALM=announcement-tracker-realm
KEYCLOAK_CLIENT_ID=announcement-tracker-app
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_CLIENT_AUTH_METHOD=client_secret_basic

# Production session cookies require HTTPS.
SPRING_PROFILES_ACTIVE=prod
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=Lax
LOCAL_LOGIN_ENABLED=false
SSO_ENABLED=true
APP_BASE_URL=https://announcements.example.com

# Docker ile yerel Keycloak kurulumu için yalnızca geliştirme değerleridir.
# Bu parolaları canlı ortamda kullanmayın.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=change-me
KEYCLOAK_CONSOLE_ADMIN_USERNAME=platform-admin
KEYCLOAK_CONSOLE_ADMIN_PASSWORD=change-me
KEYCLOAK_ADMIN_CLIENT_ID=announcement-tracker-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN_SYNC_ENABLED=true
